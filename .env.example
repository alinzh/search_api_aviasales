# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace_me

# Travelpayouts / Aviasales Data API token
AVIASALES_TOKEN=replace_me

# Optional affiliate marker. If set, ticket links will include marker/sub_id.
TRAVELPAYOUTS_MARKER=

# Optional Travelpayouts Project ID (trs). When set, raw Aviasales links are
# converted to real partner links via POST https://api.travelpayouts.com/links/v1/create.
# Find it at https://app.travelpayouts.com/profile/sources (column "ID").
TRAVELPAYOUTS_TRS=

# Bot/admin settings
ADMIN_TELEGRAM_IDS=123456789,987654321
BOT_CURRENCY=rub
BOT_MARKET=ru
BOT_TOP_LIMIT=7
BOT_REQUEST_TIMEOUT_SECONDS=15
